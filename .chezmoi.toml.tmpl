{{- $hostname := promptString "hostname" -}}
{{- $email := promptString "email" -}}
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

[data]
    hostname = {{ $hostname | quote }}
    email = {{ $email | quote }}
    osid = {{ $osid | quote }}